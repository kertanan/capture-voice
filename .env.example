# Salin file ini menjadi .env lalu isi API key

# Urutan backend fallback: Groq gpt-oss-120b -> Groq gpt-oss-20b -> Gemini
# (Cerebras dihapus: free trial butuh pembayaran -> HTTP 402)
BACKEND_ORDER=groq,groq2,gemini

# Groq (https://console.groq.com). Satu API key untuk dua model.
# Kuota rate-limit dihitung terpisah per model, jadi groq2 jadi cadangan saat groq kena 429.
GROQ_API_KEY=gsk_isi_key_kamu_di_sini
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# Gemini (Google AI Studio). Cek nama model terbaru di AI Studio.
GEMINI_API_KEY=isi_key_gemini_di_sini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REASONING=none

# Fallback lokal (LM Studio > Developer > Start Server) — opsional.
# Tambahkan 'local' ke BACKEND_ORDER kalau mau dipakai.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=granite-4.0-micro

# ASR lokal: pakai cpu + base.en kalau tidak ada GPU NVIDIA
WHISPER_DEVICE=cuda
WHISPER_MODEL=small.en

# Naikkan (mis. 0.02) kalau noise latar ikut terdeteksi sebagai pertanyaan
SILENCE_RMS=0.01
MAX_CONTEXT_CHARS=12000
# Konteks yang benar-benar dikirim ke LLM per pertanyaan (hemat token, target <2k token/request)
CONTEXT_BUDGET_CHARS=6000

# Router
MAX_TOKENS=200
RATE_LIMIT_COOLDOWN=60
ERROR_COOLDOWN=15
