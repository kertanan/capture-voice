# Salin file ini menjadi .env lalu isi API key

# Urutan backend fallback: Claude (kualitas terbaik) -> Groq (cepat) -> Gemini
# Bisa diubah, mis. "groq,groq2,claude,gemini" kalau ingin Groq dulu demi kecepatan.
BACKEND_ORDER=claude,groq,groq2,gemini

# Claude (Anthropic, https://console.anthropic.com -> API Keys). Key diawali sk-ant-...
# PENTING: pakai API key yang DIBUAT DI DALAM sebuah Workspace (workspace-scoped),
# bukan key organisasi default. Key organisasi yang tidak scoped ke workspace akan
# ditolak lewat endpoint OpenAI-compatible dengan error 400
# "This API key is not scoped to a workspace ...".
# Model contoh yang valid: claude-sonnet-4-20250514, claude-3-5-haiku-20241022.
ANTHROPIC_API_KEY=sk-ant-isi_key_workspace_kamu_di_sini
CLAUDE_MODEL=claude-sonnet-4-20250514
# Opsional & hanya untuk endpoint native (bukan OpenAI-compat). Kosongkan saja;
# untuk router ini gunakan key workspace-scoped di atas.
ANTHROPIC_WORKSPACE_ID=

# Groq (https://console.groq.com). Satu API key untuk dua model.
# Kuota rate-limit dihitung terpisah per model, jadi groq2 jadi cadangan saat groq kena 429.
GROQ_API_KEY=gsk_isi_key_kamu_di_sini
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# Gemini (Google AI Studio). Cek nama model terbaru di AI Studio.
GEMINI_API_KEY=isi_key_gemini_di_sini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REASONING=none

# Fallback lokal (LM Studio > Developer > Start Server) — opsional.
# Tambahkan 'local' ke BACKEND_ORDER kalau mau dipakai.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=granite-4.0-micro

# ASR lokal: pakai cpu + base.en kalau tidak ada GPU NVIDIA
WHISPER_DEVICE=cuda
WHISPER_MODEL=small.en

# Naikkan (mis. 0.02) kalau noise latar ikut terdeteksi sebagai pertanyaan
SILENCE_RMS=0.01
# Muat seluruh isi paper (.docx/.pdf) + ringkasan sebagai konteks
MAX_CONTEXT_CHARS=60000
# Konteks yang benar-benar dikirim ke LLM per pertanyaan (dipilih paling relevan)
CONTEXT_BUDGET_CHARS=5000

# Router
MAX_TOKENS=320
RATE_LIMIT_COOLDOWN=60
ERROR_COOLDOWN=15
