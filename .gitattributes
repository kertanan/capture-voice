# Normalkan line ending: simpan sebagai LF di repository, checkout apa adanya.
# Ini menghilangkan peringatan "LF will be replaced by CRLF" di Windows.
* text=auto eol=lf

# Berkas kode & teks -> paksa LF
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.env   text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Berkas biner -> jangan diutak-atik Git (tanpa konversi eol/diff)
*.pdf   binary
*.docx  binary
*.bin   binary
*.pt    binary
*.onnx  binary
*.pyc   binary
